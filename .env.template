# ---- App ----
APP_NAME=fastapi-ai-scaffold
APP_ENV=dev
LOG_LEVEL=INFO
# Comma-separated allowed CORS origins. Do NOT use "*" together with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Database (async) ----
# sqlite (zero-config dev): sqlite+aiosqlite:///./dev.db
# mysql  (async):           mysql+aiomysql://user:pass@host:3306/db
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DB_ECHO=false

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---- Auth / JWT ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 未验证邮箱是否禁止登录（true / false）
REQUIRE_EMAIL_VERIFICATION=true

# ---- Email (verification) ----
# console=打印到 stdout（默认，零配置）| smtp=真实发信
EMAIL_BACKEND=console
# EMAIL_FROM=no-reply@example.com
# EMAIL_VERIFY_EXPIRE_HOURS=24
# 验证链接前缀（指向你的前端 / 后端地址）
APP_BASE_URL=http://localhost:8000
# ---- SMTP（仅当 EMAIL_BACKEND=smtp 时填写）----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=secret

# ---- Milvus (optional) ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=demo_collection
VECTOR_DIM=768

# ---- Neo4j (optional) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_DATABASE=neo4j
